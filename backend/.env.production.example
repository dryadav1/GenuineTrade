NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/genuine-trade?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://app.genuinetrade.example
FRONTEND_URL=https://app.genuinetrade.example
ADMIN_EMAIL=admin@genuinetrade.example
ADMIN_PASSWORD=ChangeThisStrongPassword
ALLOW_NEW_REGISTRATIONS=true
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
LOGIN_OTP_TTL_SECONDS=300
LOGIN_OTP_MAX_ATTEMPTS=3
REQUIRE_PHONE_VERIFICATION=true
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@genuinetrade.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
STRIPE_CHECKOUT_SUCCESS_URL=https://app.genuinetrade.example/profile
STRIPE_CHECKOUT_CANCEL_URL=https://app.genuinetrade.example/profile
RAZORPAY_KEY_ID=rzp_live_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_PLAN_PROFESSIONAL_MONTHLY=
RAZORPAY_PLAN_PROFESSIONAL_ANNUAL=
RAZORPAY_PLAN_ENTERPRISE_MONTHLY=
RAZORPAY_PLAN_ENTERPRISE_ANNUAL=
DEFAULT_BASE_CURRENCY=USD
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
CACHE_DRIVER=memory
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=250
AUTH_RATE_LIMIT_MAX=30
JSON_BODY_LIMIT=15mb
KYC_DOCUMENT_MAX_SIZE_BYTES=5242880
